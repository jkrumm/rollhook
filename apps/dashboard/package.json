{
  "name": "@rollhook/dashboard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "tokens": "basalt-ui tokens:css --selector-class dark --only core --out src/styles/basalt-tokens.css",
    "tokens:check": "bun run tokens --check",
    "check:theme": "basalt-ui check-theme && basalt-ui check-theme --audit-allows",
    "check:sync": "basalt-ui sync --check",
    "generate:api": "orval"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@rollhook/ui": "workspace:*",
    "lucide-react": "0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "basalt-ui": "2.29.0",
    "orval": "8.46.0",
    "tailwindcss": "4.3.3",
    "vite": "7.3.1"
  },
  "basalt": {
    "profile": "tokens-only"
  }
}
