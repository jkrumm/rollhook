{
  "name": "@rollhook/dashboard",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "basalt": {
    "profile": "tokens-only"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check:theme": "basalt-ui check-theme && basalt-ui check-theme --audit-allows",
    "check:sync": "basalt-ui sync --check",
    "generate:api": "orval"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@rollhook/ui": "workspace:*",
    "basalt-ui": "1.30.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "orval": "^8.5.3",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1"
  }
}
