{
  "name": "@rollhook/marketing",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "tokens": "basalt-ui tokens:css --selector-class dark --only core --out src/styles/basalt-tokens.css",
    "tokens:check": "bun run tokens --check",
    "typecheck": "astro check && tsc --noEmit",
    "check:theme": "basalt-ui check-theme && basalt-ui check-theme --audit-allows",
    "check:sync": "basalt-ui sync --check",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "basalt-ui": "2.29.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "basalt": {
    "profile": "tokens-only"
  }
}
