{
  "name": "@rollhook/marketing",
  "type": "module",
  "version": "0.0.1",
  "basalt": {
    "profile": "tokens-only"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "tokens": "basalt-ui tokens:css --selector-class dark --only core --no-legacy-aliases --out src/styles/basalt-tokens.css",
    "tokens:check": "basalt-ui tokens:css --selector-class dark --only core --no-legacy-aliases --out src/styles/basalt-tokens.css --check",
    "typecheck": "astro check && tsc --noEmit",
    "check:theme": "basalt-ui check-theme && basalt-ui check-theme --audit-allows",
    "check:sync": "basalt-ui sync --check",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "5.0.0",
    "@astrojs/sitemap": "3.7.1",
    "astro": "6.0.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.7",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.2.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "basalt-ui": "1.30.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
